# ---- Airport360 backend (copy to .env for local dev) ----
# Database: PostgreSQL in production, SQLite for local dev, Turso (libSQL) on Render —
# same SQLAlchemy models.
DATABASE_URL=sqlite:///./airport360.db
# For PostgreSQL in docker-compose, use:
# DATABASE_URL=postgresql+psycopg://airport360:airport360@postgres:5432/airport360
# For Turso on Linux/Render (requires sqlalchemy-libsql from requirements-turso.txt):
# DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io?secure=true
# TURSO_AUTH_TOKEN=<turso db token>

SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated)
CORS_ORIGINS=["http://localhost:5173"]

# Bootstrapping credentials used by the seed script only
SEED_ADMIN_EMAIL=admin@airport360.local
SEED_ADMIN_PASSWORD=Demo1234!

# ---- Frontend ----
# VITE_API_URL is not required: vite proxies /v1 to the backend in dev.
