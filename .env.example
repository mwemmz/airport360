# ---- Airport360 backend (copy to .env for local dev) ----
# Database: SQLite for local dev, Turso (libSQL) on Render — same SQLAlchemy models.
# Local dev:
DATABASE_URL=sqlite:///./airport360.db

# For Turso on Linux/Render (requires sqlalchemy-libsql from requirements-turso.txt):
#   TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<turso db token>
# The code reads TURSO_DATABASE_URL first, then falls back to DATABASE_URL
# (e.g. sqlite+libsql://<db>-<org>.turso.io?secure=true), so existing setups keep working.

SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated)
CORS_ORIGINS=["http://localhost:5173"]

# Bootstrapping credentials used by the seed script only
SEED_ADMIN_EMAIL=admin@airport360.local
SEED_ADMIN_PASSWORD=Demo1234!

# ---- Frontend ----
# VITE_API_URL is not required: vite proxies /v1 to the backend in dev.
